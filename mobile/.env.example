# Copy to .env and adjust. Never commit .env.
# Expo inlines every EXPO_PUBLIC_* variable into the bundle, so nothing here is
# secret — see docs/privacy.md.

# Base URL of the API.
# Android emulator talking to a backend on the host: http://10.0.2.2:3000
# After the first deploy: the api_endpoint output of `terraform output`.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
EXPO_PUBLIC_API_TIMEOUT_MS=12000

# Administrative sign-in (Cognito). Values come from `terraform output`.
EXPO_PUBLIC_COGNITO_REGION=sa-east-1
EXPO_PUBLIC_COGNITO_CLIENT_ID=

# AdMob. Keep disabled in development; the unit id below is Google's public
# test banner and never generates revenue or real impressions.
EXPO_PUBLIC_ADS_ENABLED=false
EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID=ca-app-pub-3940256099942544/6300978111

# Chave do Maps para Android, lida pelo app.config.js em tempo de build.
# Sem o prefixo EXPO_PUBLIC_ de proposito: ela nao vai para o bundle JS, so
# para o manifesto nativo. Restrinja por pacote + SHA-1 no Google Cloud.
GOOGLE_MAPS_ANDROID_API_KEY=
